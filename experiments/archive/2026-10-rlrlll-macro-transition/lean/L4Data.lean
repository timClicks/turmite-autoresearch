theorem s1_cert2 : runB 383 ({ g := List.replicate 14 blank ++ top2 ++ [bulk2], x := 0, y := 20, h := 3 } : St) = some ({ g := U2 ++ [A2], x := -1, y := 44, h := 2 } : St) := by decide +kernel

theorem s3_cert2 : runB 216 ({ g := [A2, bulk2] ++ bottom2 ++ List.replicate 14 blank, x := -1, y := 1, h := 2 } : St) = some ({ g := [Ap2] ++ D32, x := 1, y := -1, h := 0 } : St) := by decide +kernel

theorem s5_cert2 : runB 323 ({ g := U2 ++ [Ap2], x := 1, y := 42, h := 0 } : St) = some ({ g := E52, x := -3, y := 19, h := 3 } : St) := by decide +kernel

theorem descent_certB2 : runB 20 ({ g := [A2, bulk2, bulk2], x := -1, y := 1, h := 2 } : St) = some ({ g := rp2 ++ [A2], x := -1, y := 3, h := 2 } : St) := by decide +kernel

theorem return_certB2 : runB 4 ({ g := rp2 ++ [Ap2], x := 1, y := 1, h := 0 } : St) = some ({ g := [Ap2] ++ rpp2, x := 1, y := -1, h := 0 } : St) := by decide +kernel

theorem e5_shift2 : E52.map shiftRow = List.replicate 13 blank ++ nextTop2 ++ List.replicate 2 bulk0 := by decide +kernel

theorem d3_shift2 : D32.map shiftRow = List.replicate 2 bulk0 ++ nextBottom2 ++ List.replicate 13 blank := by decide +kernel

theorem band_shift2 : rpp2.map shiftRow = [bulk0, bulk0] := by decide +kernel

theorem composition2 (n : Nat) : (final2 n).g.map shiftRow = List.replicate 13 blank ++ nextTop2 ++ List.replicate (2*n+4) bulk0 ++ nextBottom2 ++ List.replicate 13 blank := by
  have hc := compose_band E52 D32 rpp2 (List.replicate 13 blank ++ nextTop2) (nextBottom2 ++ List.replicate 13 blank) bulk0 2 2 e5_shift2 d3_shift2 band_shift2 n
  simpa [final2, List.append_assoc, show 2 + 2*n + 2 = 2*n+4 by omega] using hc

theorem clock2 (n : Nat) : 383 + 20*n + 216 + 4*n + 323 = 12*(2+2*n) + 898 := by omega

theorem cycle2 (n : Nat) : runB (12*(2+2*n) + 898) (initial2 n) = some (final2 n) := by
  rw [← clock2 n]
  have hc := cycle_chain (List.replicate 14 blank ++ top2) (bottom2 ++ List.replicate 14 blank) U2 D32 E52 bulk2 A2 Ap2 rp2 rpp2 20 19 383 323 rfl s1_cert2 descent_certB2 s3_cert2 return_certB2 s5_cert2 n
  simpa only [initial2, final2, List.append_assoc] using hc

theorem cycle_runN2 (n : Nat) : runN (12*(2+2*n) + 898) (initial2 n) = some (final2 n) := runB_runN _ _ _ (cycle2 n)

theorem first_arrival2 (n i : Nat) (u : St) (hi : i < 12*(2+2*n) + 898) (hu : runN i (initial2 n) = some u) : -2 ≤ u.x ∧ u.x ≤ 47 := runB_prefix _ _ _ _ _ (cycle2 n) hi hu

