theorem s1_cert1 : runB 383 ({ g := List.replicate 14 blank ++ top1 ++ [bulk1], x := 0, y := 21, h := 3 } : St) = some ({ g := U1 ++ [A1], x := -1, y := 45, h := 2 } : St) := by decide +kernel

theorem s3_cert1 : runB 216 ({ g := [A1, bulk1] ++ bottom1 ++ List.replicate 14 blank, x := -1, y := 1, h := 2 } : St) = some ({ g := [Ap1] ++ D31, x := 1, y := -1, h := 0 } : St) := by decide +kernel

theorem s5_cert1 : runB 483 ({ g := U1 ++ [Ap1], x := 1, y := 43, h := 0 } : St) = some ({ g := E51, x := -3, y := 20, h := 3 } : St) := by decide +kernel

theorem descent_certB1 : runB 20 ({ g := [A1, bulk1, bulk1], x := -1, y := 1, h := 2 } : St) = some ({ g := rp1 ++ [A1], x := -1, y := 3, h := 2 } : St) := by decide +kernel

