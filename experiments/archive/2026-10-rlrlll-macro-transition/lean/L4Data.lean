theorem e5_shift1 : E51.map shiftRow = List.replicate 14 blank ++ nextTop1 ++ List.replicate 2 bulk2 := by decide +kernel

theorem d3_shift1 : D31.map shiftRow = List.replicate 2 bulk2 ++ nextBottom1 ++ List.replicate 13 blank := by decide +kernel

theorem band_shift1 : rpp1.map shiftRow = [bulk2, bulk2] := by decide +kernel

theorem composition1 (n : Nat) : (final1 n).g.map shiftRow = List.replicate 14 blank ++ nextTop1 ++ List.replicate (2*n+4) bulk2 ++ nextBottom1 ++ List.replicate 13 blank := by
  have hc := compose_band E51 D31 rpp1 (List.replicate 14 blank ++ nextTop1) (nextBottom1 ++ List.replicate 13 blank) bulk2 2 2 e5_shift1 d3_shift1 band_shift1 n
  simpa [final1, List.append_assoc, show 2 + 2*n + 2 = 2*n+4 by omega] using hc

theorem clock1 (n : Nat) : 383 + 20*n + 216 + 4*n + 483 = 12*(2+2*n) + 1058 := by omega

theorem cycle1 (n : Nat) : runB (12*(2+2*n) + 1058) (initial1 n) = some (final1 n) := by
  rw [← clock1 n]
  have hc := cycle_chain (List.replicate 14 blank ++ top1) (bottom1 ++ List.replicate 14 blank) U1 D31 E51 bulk1 A1 Ap1 rp1 rpp1 21 20 383 483 rfl s1_cert1 descent_certB1 s3_cert1 return_certB1 s5_cert1 n
  simpa only [initial1, final1, List.append_assoc] using hc

theorem cycle_runN1 (n : Nat) : runN (12*(2+2*n) + 1058) (initial1 n) = some (final1 n) := runB_runN _ _ _ (cycle1 n)

theorem first_arrival1 (n i : Nat) (u : St) (hi : i < 12*(2+2*n) + 1058) (hu : runN i (initial1 n) = some u) : -2 ≤ u.x ∧ u.x ≤ 47 := runB_prefix _ _ _ _ _ (cycle1 n) hi hu

